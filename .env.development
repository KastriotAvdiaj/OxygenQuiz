# Base URL for all backend (ASP.NET) API calls from the frontend, local dev server.
VITE_API_URL=https://localhost:7153/api


# Favicon, substituted into index.html at serve time (Vite HTML env replacement).
# Deliberately the generic Vite mark, NOT the O₂ brand icon: it's what makes the dev
# tab distinguishable from a production tab when both are open. See docs/development/favicon.md.
VITE_FAVICON=/vite.svg
