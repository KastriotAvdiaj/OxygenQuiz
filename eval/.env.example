# Copy to eval/.env and fill in. Nothing here is read by the app — only by the harness.

# Your running API, with the /api prefix. The harness calls POST /quiz/ai-prompt on it to get
# the production prompt, and nothing else.
EVAL_API_URL=https://localhost:7153/api
EVAL_API_EMAIL=
EVAL_API_PASSWORD=
# The dev API serves a self-signed certificate.
EVAL_INSECURE_TLS=1

# The model vendor. Defaults mirror Ai:Vendors:groq in appsettings.json.
EVAL_AI_API_KEY=
# EVAL_AI_BASE_URL=https://api.groq.com/openai/v1
# EVAL_AI_MODEL=openai/gpt-oss-120b
# EVAL_AI_REASONING_EFFORT=low

# Measurement settings. Temperature 0 and a fixed seed, so two runs differ only where you
# changed something. Production stays at 0.3.
# EVAL_TEMPERATURE=0
# EVAL_SEED=20261017
# Milliseconds between generations — the Groq free tier is ~8k tokens per minute.
# EVAL_THROTTLE_MS=8000
