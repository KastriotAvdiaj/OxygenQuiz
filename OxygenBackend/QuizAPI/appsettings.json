{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "https://localhost:8000",
    "Audience": "https://localhost:5173"
  },
  "Cors": {
    "AllowedOrigins": [ "https://localhost:5173", "http://localhost:5173" ]
  },
  "Signup": {
    "RequireInviteCode": true
  },
  // In-app AI quiz generation (docs/quiz/ai-quiz-generation-plan.md §14).
  // Disabled by default and enabled per-environment. ApiKey is deliberately blank here — supply
  // it as Ai__ApiKey (environment variable) or via user-secrets. Startup fails if Enabled is
  // true and the key is missing, so a half-configured deploy can't masquerade as an outage.
  "Ai": {
    "Enabled": false,
    // "OpenAiCompatible" or "Fake" — HOW a completion is fetched, not from WHOM. "Fake" returns
    // canned questions with no network call and no cost, and needs no ApiKey; use it for
    // development. Refused in Production. Any other value is refused at startup.
    "Provider": "OpenAiCompatible",
    // WHO. Any vendor speaking the OpenAI ChatCompletions format: DeepSeek below, or Alibaba's
    // Qwen compatible-mode URL. Change BaseUrl, Model and the two cost values together.
    "BaseUrl": "https://api.deepseek.com",
    "Model": "deepseek-v4-flash",
    "ApiKey": "",
    "Temperature": 0.3,
    // Reasoning models only, and unset here on purpose: sent as "reasoning_effort" ONLY when
    // present, so a vendor that does not accept the field never sees it. Values belong to the
    // model ("low"/"medium"/"high" for Groq's gpt-oss, "none"/"default" for Qwen 3.6 27B).
    // Set it in the same edit as BaseUrl, Model and the two cost values — see
    // appsettings.Development.json for a worked example, and AiOptions.ReasoningEffort for why
    // a reasoning model without it returns an empty completion.
    // "ReasoningEffort": "low",
    "TimeoutSeconds": 90,
    // Shown to the user in the wizard ("2 AI quizzes a day"), so this is a promise, not just
    // a cap. Raise it deliberately once real usage is visible in AiGenerationUsages.
    "DefaultDailyQuota": 2,
    // Two ceilings: the monthly one bounds total loss, the daily one bounds how fast it can
    // happen. Neither is the last line of defence — keep the DeepSeek account balance small.
    "MonthlyBudgetUsd": 25,
    "DailyBudgetUsd": 2,
    // Runaway guard: caps a single call's output. ~4000 covers a 15-question quiz.
    "MaxOutputTokens": 8000,
    // Cache-miss rates for whatever BaseUrl points at, so the recorded cost is an upper bound
    // on the real bill. DeepSeek V4-Flash OFF-PEAK as of 2026-08-22; DeepSeek doubles both
    // during 01:00-04:00 and 06:00-10:00 UTC and this flat model can't express that, so a
    // peak-heavy day is under-priced by up to 2x — and the budget caps below are enforced
    // against this estimate, so they loosen by the same factor. Re-check on any vendor change.
    "InputCostPerMillionUsd": 0.22,
    "OutputCostPerMillionUsd": 0.66,
    "ReservationTimeoutMinutes": 10,
    "MaxQuestionsPerGeneration": 15,
    "MaxTopicChars": 200,
    "MaxSourceChars": 40000,
    "MaxExtraInstructionChars": 500
  },
  "Authentication": {
    // External sign-in (see docs/auth/social-login-plan.md). Client ids are public values —
    // they ship in the frontend bundle anyway — so they live here, not in secrets. Disabled by
    // default; enable per-environment (Authentication__Google__Enabled=true) once the provider
    // console setup (plan §7) is done. An enabled provider with a blank ClientId fails startup.
    "Google": {
      "Enabled": false,
      "ClientId": ""
    },
    "Microsoft": {
      "Enabled": false,
      "ClientId": "",
      // "consumers" = personal Microsoft accounts only (simplest; fixed issuer).
      // "common" also accepts org accounts — see the plan before widening.
      "TenantId": "consumers"
    }
  }
}
