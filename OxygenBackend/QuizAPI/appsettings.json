{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "https://localhost:8000",
    "Audience": "https://localhost:5173"
  },
  "Cors": {
    "AllowedOrigins": [ "https://localhost:5173", "http://localhost:5173" ]
  },
  "Signup": {
    "RequireInviteCode": true
  },
  "Auth": {
    // Minimum password length, enforced by MinPasswordLengthAttribute on signup and reset, and
    // reported to the client by /Authentication/auth-config so the two cannot drift.
    //
    // 8, not the 12 this shipped with. NIST SP 800-63B puts the minimum for user-chosen secrets
    // at 8 and recommends screening against a breached-password list INSTEAD of composition
    // rules — which is what NotACommonPassword already does, and is the half actually doing the
    // work. appsettings.Development.json relaxes this further; production should not go below 8.
    "MinPasswordLength": 8
  },
  // In-app AI quiz generation and the category-palette proposer (docs/quiz/ai-quiz-generation-plan.md
  // §14). ONE section drives both features: there is no separate palette switch, key or vendor.
  //
  // Disabled by default and enabled per-environment. ApiKey is deliberately blank here — supply it
  // as Ai__ApiKey (environment variable) or via user-secrets. A configuration that cannot produce
  // a working call switches the AI features OFF and logs why; it does not stop the application.
  // See docs/adr/0004-ai-misconfiguration-disables-the-feature.md.
  "Ai": {
    "Enabled": false,

    // "OpenAiCompatible" or "Fake" — HOW a completion is fetched, not from WHOM. "Fake" returns
    // canned questions with no network call and no cost, and needs no ApiKey; use it for
    // development. Refused in Production. Any other value switches the feature off at startup.
    "Provider": "OpenAiCompatible",

    // WHO. The only value an environment overrides to change vendor. Must name an entry in
    // Vendors below; anything else switches the feature off rather than guessing.
    "Vendor": "groq",

    // The catalogue. Each entry is FIVE values that are one decision — BaseUrl, Model,
    // ReasoningEffort where the model needs one, and both cost rates. They live together because
    // changing some and not the others is the mistake this structure exists to make impossible:
    // wrong costs are silent, and both budget caps are enforced against them.
    //
    // An entry costs nothing until Vendor selects it, which is why an unused vendor can stay here
    // as documentation instead of lurking as a default nobody chose.
    "Vendors": {
      // Groq. gpt-oss-120b is a REASONING model: its thinking is billed and counted as output
      // tokens, and it is spent before any content. "low" keeps that short — without it the model
      // spends the whole allowance thinking and returns an empty completion, which is why
      // ReasoningEffort is part of the entry rather than an optional extra. The palette call's
      // 1500-token ceiling is the headroom it needs (see CategoryPalettePromptBuilder).
      // Rates: console.groq.com/docs/models, checked 2026-08-26.
      "groq": {
        "BaseUrl": "https://api.groq.com/openai/v1",
        "Model": "openai/gpt-oss-120b",
        "ReasoningEffort": "low",
        "InputCostPerMillionUsd": 0.15,
        "OutputCostPerMillionUsd": 0.60
      },

      // DeepSeek. NOT IN USE — kept as a worked second example of what an entry looks like, and
      // as the migration path if the vendor ever changes back. It was the default until
      // 2026-08-31, which was the bug: an environment that overrode nothing silently ran against
      // a vendor it had never chosen and, in our case, cannot obtain a key for.
      //
      // Not a reasoning model, hence no ReasoningEffort. Rates are the V4-Flash OFF-PEAK
      // cache-miss rates as of 2026-08-22; DeepSeek doubles both during 01:00-04:00 and
      // 06:00-10:00 UTC and this flat model cannot express that, so a peak-heavy day is
      // under-priced by up to 2x — and the budget caps loosen by the same factor. Re-check
      // api-docs.deepseek.com before selecting this.
      "deepseek": {
        "BaseUrl": "https://api.deepseek.com",
        "Model": "deepseek-v4-flash",
        "InputCostPerMillionUsd": 0.22,
        "OutputCostPerMillionUsd": 0.66
      }
    },

    "ApiKey": "",
    "Temperature": 0.3,
    "TimeoutSeconds": 90,
    // Shown to the user in the wizard ("2 AI quizzes a day"), so this is a promise, not just
    // a cap. Raise it deliberately once real usage is visible in AiGenerationUsages.
    "DefaultDailyQuota": 2,
    // Two ceilings: the monthly one bounds total loss, the daily one bounds how fast it can
    // happen. Neither is the last line of defence — keep the vendor account balance small.
    "MonthlyBudgetUsd": 25,
    "DailyBudgetUsd": 2,
    // Runaway guard: caps a single call's output — AND must fit under the selected vendor's
    // per-minute token allowance, because vendors reserve max_tokens up front rather than
    // measuring after the fact. 4000 covers a 15-question quiz (the most the app will request,
    // see MaxQuestionsPerGeneration) and stays under an 8000 TPM free tier with room for the
    // prompt. It was 8000 until 2026-08-31, which could never work on Groq's free tier — dev
    // only worked because it overrode this in user-secrets, and production has no such layer.
    "MaxOutputTokens": 4000,
    // BaseUrl, Model, ReasoningEffort and the two cost rates are NOT set here — they come from
    // the Ai:Vendors entry that Ai:Vendor selects, so that the five cannot be set apart from one
    // another. Setting them flat here still works and is warned about at startup.
    "ReservationTimeoutMinutes": 10,
    "MaxQuestionsPerGeneration": 15,
    "MaxTopicChars": 200,
    "MaxSourceChars": 40000,
    "MaxExtraInstructionChars": 500
  },
  "Authentication": {
    // External sign-in (see docs/auth/social-login-plan.md). Client ids are public values —
    // they ship in the frontend bundle anyway — so they live here, not in secrets. Disabled by
    // default; enable per-environment (Authentication__Google__Enabled=true) once the provider
    // console setup (plan §7) is done. An enabled provider with a blank ClientId fails startup.
    "Google": {
      "Enabled": false,
      "ClientId": ""
    },
    "Microsoft": {
      "Enabled": false,
      "ClientId": "",
      // "consumers" = personal Microsoft accounts only (simplest; fixed issuer).
      // "common" also accepts org accounts — see the plan before widening.
      "TenantId": "consumers"
    }
  }
}
