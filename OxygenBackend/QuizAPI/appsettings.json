{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "https://localhost:8000",
    "Audience": "https://localhost:5173"
  },
  "Cors": {
    "AllowedOrigins": [ "https://localhost:5173", "http://localhost:5173" ]
  },
  "Signup": {
    "RequireInviteCode": true
  },
  "Authentication": {
    // External sign-in (see docs/auth/social-login-plan.md). Client ids are public values —
    // they ship in the frontend bundle anyway — so they live here, not in secrets. Disabled by
    // default; enable per-environment (Authentication__Google__Enabled=true) once the provider
    // console setup (plan §7) is done. An enabled provider with a blank ClientId fails startup.
    "Google": {
      "Enabled": false,
      "ClientId": ""
    },
    "Microsoft": {
      "Enabled": false,
      "ClientId": "",
      // "consumers" = personal Microsoft accounts only (simplest; fixed issuer).
      // "common" also accepts org accounts — see the plan before widening.
      "TenantId": "consumers"
    }
  }
}
