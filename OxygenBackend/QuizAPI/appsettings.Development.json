{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": [ "https://localhost:5173" ]
  },
  "Seed": {
    "AdminUsername": "admin",
    "AdminEmail": "kaloti.avdiaj@gmail.com"
  },

  // External sign-in. Client ids are public (they ship in the frontend bundle via
  // /auth-config), so they belong here, not in user-secrets. An enabled provider with a
  // blank ClientId fails startup on purpose. See docs/auth/social-login.md §6.
  "Authentication": {
    "Google": {
      "Enabled": true,
      "ClientId": "767775155511-qn56e6j0lmjd546e8pn8lf64c6vdujgr.apps.googleusercontent.com"
    }
  },
  // AI quiz generation + the category-palette proposer. ONE switch drives both.
  //
  // The vendor is NOT repeated here any more. It lives in the Ai:Vendors catalogue in
  // appsettings.json and is selected there with Ai:Vendor, so development and production run the
  // same vendor by construction rather than by two files agreeing. Duplicating the block here is
  // exactly how a vendor swap used to leave half the old vendor behind.
  //
  // Enabled without an Ai:ApiKey falls back to the Fake provider and says so at startup — that is
  // deliberate, because this file is COMMITTED and every fresh clone inherits it. So adding
  // Ai__ApiKey to user-secrets is the only step needed to call the real vendor:
  //   dotnet user-secrets set "Ai:ApiKey" "<key>"
  // Remove it and you are back on the stub.
  // Development only: long enough to be a password, short enough to type fifty times while
  // testing signup and reset. Production stays at the 8 in appsettings.json — do not copy this
  // value there. NotACommonPassword still applies, so "password" is still refused.
  "Auth": {
    "MinPasswordLength": 4
  },
  "Ai": {
    "Enabled": true
  }
}
