{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": [ "https://localhost:5173" ]
  },
  "Seed": {
    "AdminUsername": "admin",
    "AdminEmail": "kaloti.avdiaj@gmail.com"
  },
  // Development vendor: Groq. The five values below move together — BaseUrl, Model, the two
  // cost-per-million rates and ReasoningEffort are one decision, not five. Keeping them here
  // rather than in user-secrets is deliberate: none of them is a secret, and splitting them
  // across two files is how a vendor swap leaves half the old vendor behind. Only Ai__ApiKey
  // belongs in user-secrets — if BaseUrl or Model are still set there, remove them or they
  // will silently win over this block.
  //
  // gpt-oss-120b is a REASONING model: its thinking is billed and counted as output tokens,
  // and it is spent before any content. "low" keeps that short; the palette call's 1500-token
  // ceiling is the headroom it needs. Both are required — see CategoryPalettePromptBuilder.
  "Ai": {
    "Enabled": true,
    "Provider": "OpenAiCompatible",
    "BaseUrl": "https://api.groq.com/openai/v1",
    "Model": "openai/gpt-oss-120b",
    "ReasoningEffort": "low",
    // Groq's published rates for this model (console.groq.com/docs/models, checked 2026-08-26).
    // NOT the DeepSeek rates in appsettings.json — those are 0.22/0.66 and would mis-price
    // every row in AiGenerationUsages, which is also what both budget caps are enforced against.
    "InputCostPerMillionUsd": 0.15,
    "OutputCostPerMillionUsd": 0.60
  }
}
