import { useRef, useState } from "react";
import {
  AlertTriangle,
  ArrowRight,
  Check,
  Copy,
  Sparkles,
} from "lucide-react";

import { Spinner } from "@/components/ui";
import {
  BottomDrawer,
  BottomDrawerContent,
  BottomDrawerDescription,
  BottomDrawerFooter,
  BottomDrawerHeader,
  BottomDrawerTitle,
  BottomDrawerTrigger,
} from "@/components/ui/bottom-drawer";
import { Textarea } from "@/components/ui/form";
import { cn } from "@/utils/cn";

import type { ParseResult } from "../parse-ai-output";
import { WizardButton } from "./wizard-button";

export interface CopyPasteFallbackProps {
  /**
   * Generation isn't available at all (kill switch, quota spent, unverified email). Promotes
   * the trigger from a quiet link to the panel's primary button, and swaps "or" for
   * "instead" — when this is the only path forward it shouldn't look like an aside.
   */
  forced: boolean;
  /**
   * Already wrapped by the view's validation guard — it fails the same way Generate does,
   * because it builds the same request. Just call it.
   */
  onCopyPrompt: () => void;
  copied: boolean;
  isCopying: boolean;
  aiResponse: string;
  onAiResponseChange: (value: string) => void;
  onImport: () => void;
  /** Only the failure case is rendered here; a success switches the whole view to review. */
  parseResult: ParseResult | null;
}

/**
 * Copy a prompt into your own ChatGPT, paste the reply back.
 *
 * Kept permanently, not as a legacy path: it's free, it works when the provider is down or
 * the daily allowance is gone, and some people would rather spend their own subscription
 * than our budget. The prompt comes from `POST /api/quiz/ai-prompt`, so it is the *same*
 * prompt in-app generation sends — there is only one in the codebase (plan §5.1).
 *
 * <b>A drawer, not an inline disclosure.</b> Expanded in place this was two headed steps, a
 * 140px code textarea and an error list — taller than the wizard it hangs off, so opening it
 * pushed Generate off the screen and the page you were reading rearranged itself under your
 * thumb. It is also a *detour*: you leave for another app and come back with a blob to paste.
 * That belongs on its own surface.
 *
 * `BottomDrawer` (vaul) rather than the Radix sheet in `ui/drawer.tsx`: a sheet centred in the
 * viewport is a dialog whatever the file is called. This rises from the bottom edge, keeps a
 * grab handle, and can be flicked away — the wizard stays visible above it, so it reads as
 * somewhere you stepped into and can step back out of.
 *
 * <b>It never opens itself</b>, not even when `forced`. The inline version did, on the
 * reasoning that a blocked user needs the only working path — but a modal that appears
 * unbidden on load is the same reasoning applied to a surface that takes the whole screen.
 * Forced makes the trigger loud instead, which is one tap and no ambush.
 */
export const CopyPasteFallback = ({
  forced,
  onCopyPrompt,
  copied,
  isCopying,
  aiResponse,
  onAiResponseChange,
  onImport,
  parseResult,
}: CopyPasteFallbackProps) => {
  const [open, setOpen] = useState(false);
  const contentRef = useRef<HTMLDivElement>(null);

  // Same rule as the Generate button: the action stays clickable and explains itself, rather
  // than greying out and leaving the user to work out which box is empty.
  const [showPasteError, setShowPasteError] = useState(false);
  const pasteMissing = aiResponse.trim().length === 0;
  const replyRef = useRef<HTMLTextAreaElement>(null);

  const handleImportClick = () => {
    if (pasteMissing) {
      setShowPasteError(true);
      replyRef.current?.focus();
      return;
    }

    setShowPasteError(false);
    // Deliberately no close: a parse failure renders inside this drawer, and a success
    // unmounts the whole wizard screen anyway.
    onImport();
  };

  return (
    <BottomDrawer open={open} onOpenChange={setOpen}>
      <BottomDrawerTrigger asChild>
        {forced ? (
          <WizardButton type="button" className="w-full" outerClassName="w-full">
            <span className="flex items-center justify-center gap-2">
              <Sparkles className="h-4 w-4" />
              Use your own AI instead
            </span>
          </WizardButton>
        ) : (
          <button
            type="button"
            className="flex min-h-9 w-full items-center justify-between gap-3 text-sm text-muted-foreground transition-colors hover:text-foreground"
          >
            <span>Or use your own AI (free)</span>
            <ArrowRight className="h-4 w-4 shrink-0" />
          </button>
        )}
      </BottomDrawerTrigger>

      <BottomDrawerContent
        ref={contentRef}
        // Comes up past the middle of the screen rather than sizing to its content. Two steps
        // and a code box that only reached a third of the way up read as a notification you
        // had to squint at; the point of the sheet is that it becomes the thing you're doing.
        // A floor, not a height — `max-h-[85dvh]` on the component still caps it.
        className="min-h-[70vh] supports-[height:100dvh]:min-h-[70dvh]"
        // The reply textarea is the first focusable thing in here, and focusing it on open
        // raises the phone keyboard over the instructions the user came to read. Focus the
        // content instead of nothing, so the focus trap and Escape still work
        // (docs/RESPONSIVE.md).
        onOpenAutoFocus={(event) => {
          event.preventDefault();
          contentRef.current?.focus();
        }}
      >
        <BottomDrawerHeader className="border-b border-border">
          <BottomDrawerTitle>Use your own AI</BottomDrawerTitle>
          <BottomDrawerDescription>
            Copy the prompt into ChatGPT, Claude or Gemini, then paste the reply
            back here. It's the same prompt we'd send ourselves.
          </BottomDrawerDescription>
        </BottomDrawerHeader>

        {/* min-h-0 so this scrolls instead of pushing the footer past the viewport;
            overscroll-contain so a flick past the end doesn't scroll the page behind. A flex
            column, so the height the sheet gained goes to the paste box below rather than
            pooling as dead space under it. */}
        <div className="flex min-h-0 flex-1 flex-col gap-4 overflow-y-auto overscroll-contain px-4 py-4">
          <div className="rounded-lg border-2 border-dashed border-primary/40 p-4">
            <p className="mb-1 text-sm font-medium">1. Copy the prompt</p>
            <p className="mb-3 text-xs text-muted-foreground">
              Paste it into ChatGPT, Claude, Gemini — whichever you use.
            </p>
            <WizardButton
              type="button"
              disabled={isCopying}
              onClick={onCopyPrompt}
            >
              <span className="flex items-center gap-2">
                {isCopying ? (
                  <>
                    <Spinner size="sm" /> Preparing…
                  </>
                ) : copied ? (
                  <>
                    <Check className="h-4 w-4" /> Copied
                  </>
                ) : (
                  <>
                    <Copy className="h-4 w-4" /> Copy prompt
                  </>
                )}
              </span>
            </WizardButton>
          </div>

          <div className="flex min-h-0 flex-1 flex-col">
            <p className="mb-1 text-sm font-medium">2. Paste the AI's reply</p>
            <Textarea
              ref={replyRef}
              variant="settings"
              className={cn(
                // flex-1 over the floor: the box grows into whatever the sheet has spare,
                // which is the one part of this panel that benefits from more room.
                "min-h-[140px] flex-1 font-mono text-xs",
                showPasteError &&
                  pasteMissing &&
                  "border-destructive focus-visible:ring-destructive/40"
              )}
              placeholder='{ "questions": [ ... ] }'
              value={aiResponse}
              onChange={(e) => onAiResponseChange(e.target.value)}
              aria-invalid={showPasteError && pasteMissing}
              aria-describedby={
                showPasteError && pasteMissing ? "ai-paste-error" : undefined
              }
            />

            {/* Derived, so it clears itself the moment anything is pasted. */}
            {showPasteError && pasteMissing && (
              <p
                id="ai-paste-error"
                role="alert"
                className="mt-1.5 flex items-center gap-1 text-xs text-destructive"
              >
                <AlertTriangle className="h-3 w-3 shrink-0" />
                Paste the AI's reply here first.
              </p>
            )}

            {parseResult && !parseResult.ok && (
              <div className="mt-2 rounded-md border border-destructive/40 bg-destructive/10 p-3">
                <p className="flex items-start gap-2 text-sm text-destructive">
                  <AlertTriangle className="mt-0.5 h-4 w-4 shrink-0" />
                  {parseResult.error}
                </p>
                {parseResult.dropped.length > 0 && (
                  <ul className="mt-2 list-disc space-y-1 pl-6 text-xs text-destructive/90">
                    {/* Capped at five: a reply where everything failed produces one reason per
                        question, and a wall of them buries the actual problem. */}
                    {parseResult.dropped.slice(0, 5).map((d) => (
                      <li key={d.index}>
                        Question {d.index}: {d.reason}
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            )}
          </div>
        </div>

        {/* Pinned: "Review questions" is what this drawer is for, and scrolling a 140px
            textarea shouldn't be able to push it out of reach. */}
        <BottomDrawerFooter className="border-t border-border sm:flex-row sm:justify-end">
          <WizardButton type="button" onClick={handleImportClick}>
            <span className="flex items-center justify-center gap-1">
              Review questions <ArrowRight className="h-4 w-4" />
            </span>
          </WizardButton>
        </BottomDrawerFooter>
      </BottomDrawerContent>
    </BottomDrawer>
  );
};
