# Response headers for the static site (Cloudflare Workers static assets). Vite copies public/ into
# dist/, and Cloudflare applies this file to every asset it serves — but not to responses the Worker
# builds itself, so worker/index.js repeats these (SECURITY_HEADERS). Change both together.
# docs/deployment/frontend-worker.md, "Headers"

/*
  # Browsers use HTTPS for a year after one visit, so a typed "oxygenquiz.com" never goes out over
  # plain HTTP first. No includeSubDomains/preload yet: both are hard to undo.
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # Our pages may be framed only by our own pages. Not DENY: MSAL and similar libraries can load the
  # app's own origin in a hidden iframe, and DENY would break that silently.
  X-Frame-Options: SAMEORIGIN
  # Nothing in the app uses these; refusing them limits what an injected script could ask for.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# Vite's content-hashed build output (vite.config.ts build.assetsDir). A file there is named by its
# content, so a changed file is a new URL and the browser may keep each one for a year without
# asking again. public/assets/ (unhashed images) is deliberately NOT covered: it revalidates with
# ETags, so a replaced image shows up on the next load. index.html revalidates too (Cloudflare's
# default), which is how a deploy reaches browsers. Guarded by src/lib/__tests__/build-cache.test.ts.
/_app/*
  Cache-Control: public, max-age=31536000, immutable
