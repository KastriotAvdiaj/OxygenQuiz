# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
# Shared workspace settings. Currently the jsonc association that stops the editor flagging
# the comments in appsettings*.json — a fix that is worthless if each machine has to redo it.
!.vscode/settings.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sw?
# Local, machine-specific overrides only. The non-secret per-mode files
# (.env.development / .env.production) ARE committed so CI reproduces the build.
# `*.local` above already covers .env.local and .env.*.local.


#backend 

# /OxygenBackend/QuizAPI/Program.cs
# /OxygenBackend/QuizAPI/appsettings.json doesn't cotnain sensitive info
# /OxygenBackend/QuizAPI/appsettings.Developement.json this was spelt wrong and doesn't cotnain sensitive info
# Build output, for every project in the solution rather than one. These used to be anchored
# to /OxygenBackend/QuizAPI/, so QuizAPI.Tests — added later — had its bin/ and obj/ tracked,
# and every `dotnet build` produced 33 modified files to scroll past. Unanchored and
# case-tolerant is the standard .NET pattern; a project added tomorrow is covered by default.
[Bb]in/
[Oo]bj/
/OxygenBackend/QuizAPI/.vs
/OxygenBackend/QuizAPI/app.zip
/OxygenBackend/QuizAPI/publish


*storybook.log
storybook-static

# TypeScript incremental build state. Machine-specific, rewritten by every `tsc -b`.
*.tsbuildinfo

# FUSE leftovers: a mounted filesystem renames a file to .fuse_hiddenXXXX instead of
# unlinking it while a process still has it open. Artefacts of the mount, never source.
.fuse_hidden*

# Claude Code.
# settings.json and skills/ are shared with the repo on purpose. Everything else
# under .claude/ is per-machine state and must not be committed.
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/worktrees/

# Scratch archives kept on disk but not in the repo.
_to_delete/

# Local mkcert dev certificates (vite.config.ts uses mkcert()). Regenerated on demand, and
# two of these are PRIVATE KEYS — create-ca-key.pem is a CA your machine trusts once mkcert
# has installed it, so anyone holding it can mint certificates your browser accepts. They
# were tracked until 2026-08-31; they remain in history, so regenerate with
# `mkcert -uninstall && mkcert -install` if that matters to you.
certs/
