# ⚠️ THIS FILE BELONGS TO THE UNADOPTED CADDY STACK (deploy/docker-compose.prod.yml).
# The live server does NOT read deploy/.env — it runs the compose file at the REPO ROOT, which
# has no `env_file:` at all and instead sets each variable inline under `environment:`, pulling
# secrets from ~/OxygenQuiz/.env.prod by ${...} interpolation. See
# docs/deployment/production-topology.md before copying anything here onto a server.
# This file remains the best CATALOGUE of what the backend reads — the values are right, the
# delivery mechanism is not.
#
# Copy to .env on the server and fill in real values. NEVER commit the real .env.
#   cp .env.example .env && nano .env
# Generate strong secrets:
#   Jwt__Key:        openssl rand -base64 48
#   passwords:       openssl rand -base64 24

# --- PostgreSQL (used by both the postgres container and the backend connection string) ---
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# --- ASP.NET runtime ---
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# --- JWT ---
Jwt__Key=CHANGE_ME_base64_at_least_32_bytes
Jwt__Issuer=https://api.oxygenquiz.com
Jwt__Audience=https://oxygenquiz.com

# --- Allowed hosts / CORS (exact origins, no wildcards) ---
AllowedHosts=api.oxygenquiz.com
Cors__AllowedOrigins__0=https://oxygenquiz.com
Cors__AllowedOrigins__1=https://www.oxygenquiz.com

# --- Invite-only signup gate (see docs/invite-code-system.md) ---
# true  = signup requires a valid, unused invite code (for the gated test).
# false = open public signup. Mint codes as admin via POST /api/admin/invite-codes.
Signup__RequireInviteCode=true

# --- Seeded admin account (created on first boot; change the password after first login) ---
Seed__AdminUsername=admin
Seed__AdminEmail=admin@oxygenquiz.com
Seed__AdminPassword=CHANGE_ME_strong_admin_password

# --- External sign-in: Google / Microsoft (docs/auth/social-login.md) ---
# These are the ONLY two values Google needs. There is no client secret and no frontend
# variable: the app runs the GIS ID-token flow (GoogleIdentityVerifier validates the JWT
# against Google's OIDC metadata, it never exchanges a code), and the SPA reads the client
# id from our own /auth-config endpoint — so backend config and frontend config cannot drift.
#
# Enabled=true with a blank ClientId FAILS STARTUP on purpose (Program.cs). Enabled=false is
# a SILENT, valid state: the buttons simply never render and nothing is logged. That is the
# trap this block exists to close — omit these lines and you ship without social login and
# get no error anywhere.
#
# In Google Cloud Console: OAuth client type "Web application". Authorized JavaScript
# origins must list BOTH production origins (Caddy serves apex and www with no redirect
# between them, so registering only the apex breaks every www visitor) plus the dev origin:
#   https://oxygenquiz.com   https://www.oxygenquiz.com   https://localhost:5173
# Authorized redirect URIs: leave EMPTY. Nothing in this app consumes a redirect.
# Also check the consent screen is Published — while it is in "Testing" only explicitly
# added test users can sign in, which looks exactly like "works for me, fails for everyone".
#Authentication__Google__Enabled=true
#Authentication__Google__ClientId=CHANGE_ME.apps.googleusercontent.com

# Microsoft is the same shape; both frontend origins go in the Azure app registration too.
#Authentication__Microsoft__Enabled=true
#Authentication__Microsoft__ClientId=CHANGE_ME

# --- In-app AI: quiz generation AND the category palette ---
# (docs/quiz/ai-quiz-generation-flow.md, docs/entities/category-palettes.md)
# ONE section drives BOTH features — same provider, same usage ledger, same budget. There is
# no way to enable one and not the other; Ai__Enabled=false turns off both.
# Off by default and safe to leave unset — the wizard falls back to "use your own AI".
# Enabling it with a blank Ai__ApiKey FAILS STARTUP on purpose: a half-configured deploy
# returning 502s is indistinguishable from a vendor outage.
#
# Ai__Provider is HOW, not WHO: "OpenAiCompatible" (a real call) or "Fake" (dev stub, refused in
# Production). The vendor is Ai__BaseUrl + Ai__Model — DeepSeek below, or any other endpoint
# speaking the OpenAI ChatCompletions format. Change the two cost values in the same edit as the
# vendor: they are what the budget caps are enforced against, and nothing validates them.
#Ai__Enabled=true
#Ai__Provider=OpenAiCompatible
#Ai__ApiKey=CHANGE_ME_vendor_api_key
#Ai__BaseUrl=https://api.deepseek.com
#Ai__Model=deepseek-v4-flash
# The two values the comment above means. They are NOT optional in practice: every usage row
# is costed with them, and both budget caps below are enforced against that estimate. Wrong
# numbers, zeroes, or a vendor that omits the `usage` block all disarm the caps silently —
# no error, no log line, spend just stops being counted. Change them with BaseUrl/Model.
#Ai__InputCostPerMillionUsd=0.22
#Ai__OutputCostPerMillionUsd=0.66
# Only if Ai__Model is a reasoning model (its thinking bills as output tokens). Ships unset.
#Ai__ReasoningEffort=low
# Keep the ceiling at or below the credit you actually topped up, so our cap trips before the
# vendor's balance does — a clean FeatureDisabled beats an upstream 402.
#Ai__MonthlyBudgetUsd=10
#Ai__DailyBudgetUsd=2

# --- Production config gate ---
# Leave false for the first boot; set true once the domain + cookies verify, to make
# launch-blocking misconfig fatal instead of a warning. (See Program.cs / deployment.md.)
Security__EnforceProductionConfig=false
